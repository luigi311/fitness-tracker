<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
    <id>com.luigi311.fitness-tracker</id>
    <name>Fitness Tracker</name>
    <summary>Open source fitness tracker</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <supports>
        <control>keyboard</control>
        <control>pointing</control>
        <control>touch</control>
    </supports>
    <requires>
        <display_length side="shortest" compare="ge">250</display_length>
        <display_length side="longest" compare="ge">400</display_length>
    </requires>
    <developer id="com.luigi311">
        <name>
            Luigi311
        </name>
    </developer>
    <url type="homepage">https://fitness-tracker.luigi311.com</url>
    <url type="vcs-browser">https://github.com/luigi311/fitness-tracker</url>
    <url
        type="bugtracker"
    >https://github.com/luigi311/fitness-tracker/issues</url>
    <description>
        <p>
            An open-source application for tracking sensor data from Bluetooth Low Energy (BLE)
            devices in real time, recording sessions, visualizing your workout history and uploading to intervals.icu.
        </p>
    </description>
    <screenshots>
        <screenshot type="default">
            <image type="source">
                https://raw.githubusercontent.com/luigi311/fitness-tracker/refs/tags/v3.0.0/docs/screenshots/tracker.png</image>
            <caption>Tracker View</caption>
        </screenshot>
        <screenshot type="default">
            <image type="source">
                https://raw.githubusercontent.com/luigi311/fitness-tracker/refs/tags/v3.0.0/docs/screenshots/freerun_running.png</image>
            <caption>Running indoor freerun</caption>
        </screenshot>
        <screenshot type="default">
            <image type="source">
                https://raw.githubusercontent.com/luigi311/fitness-tracker/refs/tags/v3.0.0/docs/screenshots/workout_running.png</image>
            <caption>Running indoor workout</caption>
        </screenshot>
        <screenshot type="default">
            <image type="source">
                https://raw.githubusercontent.com/luigi311/fitness-tracker/refs/tags/v3.0.0/docs/screenshots/workout_trainer.png</image>
            <caption>Cycling trainer workout</caption>
        </screenshot>
        <screenshot type="default">
            <image type="source">
                https://raw.githubusercontent.com/luigi311/fitness-tracker/refs/tags/v3.0.0/docs/screenshots/history_average.png</image>
            <caption>History activies</caption>
        </screenshot>
        <screenshot type="default">
            <image type="source">
                https://raw.githubusercontent.com/luigi311/fitness-tracker/refs/tags/v3.0.0/docs/screenshots/history_comparison.png</image>
            <caption>History comparison</caption>
        </screenshot>
    </screenshots>
    <launchable
        type="desktop-id"
    >com.luigi311.fitness-tracker.desktop</launchable>
    <releases>
        <release version="5.1.0" date="2026-08-25">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v5.1.0</url>
            <description>
                <p>
                    Improvements
                </p>
                <ul>
                    <li>Wait for a fresh, accuracy-appropriate indoor or trainer location anchor, with more time for GPS cold starts</li>
                    <li>Combine GPS starting elevation with sensor-derived elevation changes for indoor and trainer TCX exports</li>
                </ul>
                <p>
                    Bug Fixes
                </p>
                <ul>
                    <li>Prevent outdoor elevation spikes by exporting altitude only when a GPS measurement exists</li>
                    <li>Treat unknown GeoClue altitude values as missing instead of exporting invalid elevations</li>
                </ul>
            </description>
        </release>
        <release version="5.0.0" date="2026-08-20">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v5.0.0</url>
            <description>
                <p>
                    Features
                </p>
                <ul>
                    <li>Record GPS routes through the desktop location portal</li>
                    <li>Export and upload location-aware TCX activities</li>
                    <li>Filter activity history to find failed uploads</li>
                    <li>Require holding the stop button to prevent accidentally ending a workout</li>
                </ul>
                <p>
                    Improvements
                </p>
                <ul>
                    <li>Refresh live metrics more frequently</li>
                    <li>Use a more compact layout</li>
                    <li>Send workout change notifications only while the app is in the background</li>
                    <li>Launch and Close the Pebble companion app automatically with active sessions</li>
                    <li>Compress Intervals.icu activity uploads</li>
                </ul>
                <p>
                    Bug Fixes
                </p>
                <ul>
                    <li>Recover and reconcile failed Intervals.icu uploads across response variants</li>
                    <li>Improve Pebble bridge restart and shutdown reliability</li>
                </ul>
            </description>
        </release>
        <release version="4.1.0" date="2026-08-07">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v4.1.0</url>
            <description>
                <p>
                    Features
                </p>
                <ul>
                    <li>Support distance-based and mixed time-and-distance workout steps</li>
                    <li>Show distance remaining and time-and-distance workout summaries</li>
                    <li>Notify when a distance-based workout is waiting for a sensor</li>
                </ul>
                <p>
                    Bug Fixes
                </p>
                <ul>
                    <li>Keep workout progress and targets accurate across step navigation, pauses, and sensor reconnects</li>
                </ul>
            </description>
        </release>
        <release version="4.0.1" date="2026-08-03">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v4.0.1</url>
            <description>
                <p>
                    Bug Fixes
                </p>
                <ul>
                    <li>Fix passive rest reading as 1000%</li>
                    <li>Fix workouts with special characters not rendering</li>
                </ul>
            </description>
        </release>
        <release version="4.0.0" date="2026-07-30">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v4.0.0</url>
            <description>
                <p>
                    Features
                </p>
                <ul>
                    <li>Workout Bias controls</li>
                    <li>Workout/Freeride ERG Power/Resistance controls</li>
                    <li>Heart Rate target workouts</li>
                    <li>Support Pebble BLE via Cobble</li>
                </ul>
                <p>
                    Bug Fixes
                </p>
                <ul>
                    <li>Fix dbus sessions runaway</li>
                </ul>
            </description>
        </release>
        <release version="3.0.2" date="2026-05-10">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v3.0.2</url>
            <description>
                <p>
                    Bug Fixes
                </p>
                <ul>
                    <li>Fix pebble scan</li>
                    <li>Adjust margins to fit mobile better</li>
                </ul>
            </description>
        </release>
        <release version="3.0.1" date="2026-04-20">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v3.0.1</url>
            <description>
                <p>
                    New Features
                </p>
                <ul>
                    <li>Add flathub build</li>
                </ul>
            </description>
        </release>
        <release version="3.0.0" date="2026-04-17">
            <url
                type="details"
            >https://github.com/luigi311/fitness-tracker/releases/tag/v3.0.0</url>
            <description>
                <p>
                    New Features
                </p>
                <ul>
                    <li>Add Trainers with erg mode</li>
                    <li>Add incline control when indoor</li>
                    <li>Add cycling (Untested)</li>
                </ul>
                <p>
                    Bug Fixes
                </p>
                <ul>
                    <li>Speedup connections</li>
                </ul>
            </description>
        </release>
    </releases>
    <content_rating type="oars-1.1" />
    <update_contact>git@luigi311.com</update_contact>
    <branding>
        <color type="primary" scheme_preference="light">#ccf2ff</color>
        <color type="primary" scheme_preference="dark">#00394d</color>
    </branding>
</component>
